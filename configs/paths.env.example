# Source this file after editing; the CLI never reads a private .env automatically.
export RISDA_DATA_ROOT=/path/to/prepared_data
export RISDA_MODEL_ROOT=/path/to/models
export RISDA_OUTPUT_ROOT=/path/to/risda_outputs
# Expected data subdirectories: era5_hourly/, observations/, normalization/.
# Override individual RISDA_* paths if your prepared-data layout differs.
export RISDA_ERA5_1H="$RISDA_DATA_ROOT/era5_hourly"
export RISDA_OBS_ROOT="$RISDA_DATA_ROOT/observations"
export RISDA_MEAN_STD="$RISDA_DATA_ROOT/normalization"
export RISDA_LATENT_DIR="$RISDA_MODEL_ROOT/era_latents"
export RISDA_DENOISER_DIR="$RISDA_LATENT_DIR/denoisers/prior"
export WANDB_MODE=disabled

